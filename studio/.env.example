SANITY_STUDIO_PROJECT_ID="<paste your project id here>" # Required - The ID of your Sanity project
SANITY_STUDIO_DATASET="production" # Optional - The dataset of your Sanity project, defaults to production
SANITY_STUDIO_PREVIEW_URL="http://localhost:3000" # Optional - The URL of the frontend used for previews, defaults to http://localhost:3000
SANITY_STUDIO_STUDIO_HOST="" # Optional - The hostname for the deployed studio (sanity deploy)
